<!DOCTYPE html>
<html>
  <head>
    <title>URL Shortener</title>
  </head>

  <body>
    <h1>URL Shortener</h1>

    <form action="/url" method="POST">
      <label>Enter Your Original URL</label>

      <input
        type="text"
        name="url"
        placeholder="https://example.com"
        required
      />

      <button type="submit">Generate</button>
    </form>

    <br />

    <table border="1">
      <thead>
        <tr>
          <th>S. No</th>
          <th>ShortID</th>
          <th>Redirect</th>
          <th>Clicks</th>
        </tr>
      </thead>

      <tbody>
        <% urls.forEach((url, index) => { %>
          <tr>
            <td><%= index + 1 %></td>

            <td>
              <a href="/<%= url.shortId %>">
                <%= url.shortId %>
              </a>
            </td>

            <td>
              <%= url.redirectURL %>
            </td>

            <td>
              <%= url.visitHistory.length %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </body>
</html>